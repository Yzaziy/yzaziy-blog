---
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
  { href: '/', label: '首页' },
  { href: '/about', label: '关于' },
];
---

<header class="sticky top-0 z-40 backdrop-blur-md bg-white/80 dark:bg-zinc-950/80 border-b border-zinc-200 dark:border-zinc-800">
  <div class="max-w-4xl mx-auto px-4 h-16 flex items-center justify-between">
    <a href="/" class="text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 hover:opacity-80 transition">
      Yzaziy
    </a>
    <div class="flex items-center space-x-6">
      <nav class="flex items-center space-x-4">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition"
          >
            {item.label}
          </a>
        ))}
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>

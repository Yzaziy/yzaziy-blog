---
import { sidebarItems, type MenuItem } from '../data/sidebar';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (item: MenuItem): boolean =>
  !!(item.href && item.href !== '#' && item.href.replace(/\/$/, '') === currentPath)
  || !!item.children?.some(isActive);
const iconPaths: Record<string, string> = {
  chip: 'M9 3v2m6-2v2M9 19v2m6-2v2M3 9h2m-2 6h2m14-6h2m-2 6h2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z',
  cube: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4',
  sparkles: 'M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z',
  folder: 'M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z',
  gamepad: 'M15 12h.01M18 10h.01M6 12h4m-2-2v4m1-8h6a4 4 0 014 4v5a3 3 0 01-3 3h-1.5a2 2 0 00-1.414.586l-1.086 1.086a2 2 0 01-2.828 0l-1.086-1.086A2 2 0 008.5 19H7a3 3 0 01-3-3v-5a4 4 0 014-4z',
  monitor: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  heart: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z',
};
---

<nav class="sidebar-scroll sidebar-nav" aria-label="文章分类">
  <p class="sidebar-label">学习与记录</p>
  {sidebarItems.map((item) => item.children?.length ? (
    <details class="sidebar-group" open={item.id === 'embedded' || isActive(item)}>
      <summary class="sidebar-row">
        <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d={iconPaths[item.icon]} /></svg>
        <span>{item.title}</span>
        <svg class="sidebar-chevron" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="m9 5 7 7-7 7" /></svg>
      </summary>
      <div class="sidebar-tree">
        {item.children.map((child) => child.children?.length ? (
          <details class="sidebar-rank" open={isActive(child)} data-current={isActive(child) || undefined}>
            <summary class="sidebar-rank-row">
              <svg class="sidebar-chevron" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="m9 5 7 7-7 7" /></svg>
              <span>{child.title}</span>
              {child.badge && <img src={child.badge} alt="" width="26" height="26" class="rank-icon" loading="lazy" />}
            </summary>
            <div class="sidebar-articles">
              {child.children.map((article) => (
                <a href={article.href} data-nav-link class="sidebar-article" aria-current={isActive(article) ? 'page' : undefined}>{article.title}</a>
              ))}
            </div>
          </details>
        ) : child.href && child.href !== '#' ? (
          <a href={child.href} data-nav-link class="sidebar-rank-row" aria-current={isActive(child) ? 'page' : undefined}>
            <span>{child.title}</span>
            {child.badge && <img src={child.badge} alt="" width="26" height="26" class="rank-icon" loading="lazy" />}
          </a>
        ) : (
          <span class="sidebar-pending" aria-disabled="true" title="内容整理中">
            <span>{child.title}</span>
            {child.badge ? <img src={child.badge} alt="" width="26" height="26" class="rank-icon" loading="lazy" /> : <small>待更新</small>}
          </span>
        ))}
      </div>
    </details>
  ) : item.href && item.href !== '#' ? (
    <a href={item.href} data-nav-link class="sidebar-row" aria-current={isActive(item) ? 'page' : undefined}>
      <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d={iconPaths[item.icon]} /></svg>
      <span>{item.title}</span>
    </a>
  ) : (
    <div class="sidebar-row sidebar-pending" aria-disabled="true" title="赞助通道暂未开放">
      <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d={iconPaths[item.icon]} /></svg>
      <span>{item.title}</span><small>筹备中</small>
    </div>
  ))}
</nav>

<script>
  function updateSidebar() {
    const path = location.pathname.replace(/\/$/, '') || '/';
    document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((link) => {
      const active = new URL(link.href).pathname.replace(/\/$/, '') === path;
      if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
    document.querySelectorAll<HTMLDetailsElement>('.sidebar-rank').forEach((rank) => {
      const active = !!rank.querySelector('[aria-current="page"]');
      if (active) {
        rank.dataset.current = 'true';
        rank.open = true;
        const group = rank.closest<HTMLDetailsElement>('.sidebar-group');
        if (group) group.open = true;
      } else delete rank.dataset.current;
    });
  }
  document.addEventListener('astro:page-load', updateSidebar);
</script>

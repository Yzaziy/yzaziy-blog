---
interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  slug: string;
  href?: string;
}

const { title, description, pubDate, updatedDate, tags = [], slug, href } = Astro.props;
const date = updatedDate || pubDate;
const formattedDate = date.toLocaleDateString('zh-CN', {
  year: 'numeric', month: '2-digit', day: '2-digit',
}).replaceAll('/', '.');
const linkUrl = href || `/blog/${slug}`;
---

<article class="post-row">
  <div class="post-meta">
    <span>{tags.slice(0, 2).join(' · ') || '随笔'}</span>
    <time datetime={date.toISOString()}>{updatedDate ? '更新于 ' : ''}{formattedDate}</time>
  </div>
  <h3 class="post-title">
    <a href={linkUrl} class="post-link">{title}</a>
  </h3>
  {description && <p class="post-description">{description}</p>}
  <svg class="post-arrow" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M5 12h14m-6-6 6 6-6 6" />
  </svg>
</article>

---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Yzaziy 的个人博客与主页' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <!-- Astro 客户端路由（实现页面无刷新切换、背景持续连贯加载） -->
    <ClientRouter />
    <script is:inline>
      function getDesiredTheme() {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      }

      function applySavedTheme(doc = document) {
        const theme = getDesiredTheme();
        if (theme === 'dark') {
          doc.documentElement.classList.add('dark');
        } else {
          doc.documentElement.classList.remove('dark');
        }
      }

      // 1. 首屏加载瞬间应用
      applySavedTheme();

      // 2. 关键核心修复：在 DOM 切换前直接给新文档预先加上 dark class，彻底杜绝单帧白屏闪烁
      document.addEventListener('astro:before-swap', (event) => {
        applySavedTheme(event.newDocument);
      });
      document.addEventListener('astro:after-swap', () => applySavedTheme());
      document.addEventListener('astro:page-load', () => applySavedTheme());
    </script>
  </head>
  <body class="flex flex-col min-h-screen relative text-zinc-900 dark:text-zinc-100 antialiased">
    <!-- 全局持久化动态背景视频（transition:persist 实现切页不间断、不闪烁） -->
    <div
      id="bg-video-wrapper"
      transition:persist
      class="fixed inset-0 -z-50 overflow-hidden pointer-events-none select-none"
    >
      <video
        id="bg-video"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        class="absolute inset-0 w-full h-full object-cover filter blur-[5px] scale-105 transform-gpu"
      >
        <source src="/bg-video.mp4" type="video/mp4" />
      </video>
      <!-- 磨砂半透明遮罩 -->
      <div class="absolute inset-0 bg-white/75 dark:bg-zinc-950/80 backdrop-blur-[1px]"></div>
    </div>

    <!-- 顶部导航 -->
    <Header />

    <!-- 页面主体内容（居于最上层） -->
    <div class="flex-grow flex w-full relative z-10 items-start">
      <!-- 桌面端侧边栏（始终吸附顶端 sticky top-16，高度与视口契合 h-[calc(100vh-4rem)]，内置滑动条） -->
      <div
        class="hidden md:block w-72 flex-shrink-0 sticky top-16 h-[calc(100vh-4rem)] z-30 self-start"
        transition:persist="sidebar-desktop"
      >
        <Sidebar />
      </div>

      <!-- 移动端侧边抽屉 -->
      <div id="mobile-sidebar-drawer" class="fixed inset-0 z-50 hidden md:hidden">
        <div id="mobile-sidebar-backdrop" class="fixed inset-0 bg-black/40 backdrop-blur-sm transition-opacity"></div>
        <div class="fixed inset-y-0 left-0 w-72 bg-white/90 dark:bg-zinc-950/90 backdrop-blur-md shadow-xl flex flex-col z-10 border-r border-zinc-200/80 dark:border-zinc-800/80">
          <div class="p-4 border-b border-zinc-200/80 dark:border-zinc-800/80 flex items-center justify-between">
            <span class="font-bold text-zinc-900 dark:text-zinc-100">分类导航</span>
            <button id="close-mobile-sidebar" class="p-1 rounded-md text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100" aria-label="关闭侧边栏">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
          <div class="flex-1 overflow-y-auto sidebar-scroll">
            <Sidebar />
          </div>
        </div>
      </div>

      <!-- 主内容区域（确保所有内容与交互均在最上层） -->
      <main class="flex-grow min-w-0 px-4 sm:px-10 py-10 max-w-4xl mx-auto w-full relative z-10">
        <slot />
      </main>
    </div>

    <!-- 底部信息 -->
    <Footer />

    <script is:inline>
      function initAppInteractions() {
        const toggleBtn = document.getElementById('mobile-sidebar-toggle');
        const drawer = document.getElementById('mobile-sidebar-drawer');
        const closeBtn = document.getElementById('close-mobile-sidebar');
        const backdrop = document.getElementById('mobile-sidebar-backdrop');

        if (toggleBtn) toggleBtn.onclick = () => drawer?.classList.remove('hidden');
        if (closeBtn) closeBtn.onclick = () => drawer?.classList.add('hidden');
        if (backdrop) backdrop.onclick = () => drawer?.classList.add('hidden');

        // 确保持久化视频始终处于播放状态
        const video = document.getElementById('bg-video');
        if (video && video.paused) {
          video.play().catch(() => {});
        }
      }

      initAppInteractions();
      document.addEventListener('astro:page-load', initAppInteractions);
    </script>
  </body>
</html>


---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Yzaziy 的学习与开发笔记' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      function applySavedTheme(doc = document) {
        let theme;
        try { theme = localStorage.getItem('theme'); } catch {}
        const dark = theme === 'dark' || (theme !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        doc.documentElement.classList.toggle('dark', dark);
      }
      applySavedTheme();
      document.addEventListener('astro:before-swap', (event) => applySavedTheme(event.newDocument));
      document.addEventListener('astro:after-swap', () => applySavedTheme());
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <div id="bg-video-wrapper" transition:persist class="site-background" aria-hidden="true">
      <video id="bg-video" autoplay loop muted playsinline preload="auto">
        <source src="/bg-video.mp4" type="video/mp4" />
      </video>
      <div class="site-backdrop"></div>
    </div>

    <Header />
    <aside id="sidebar-desktop-container" class="desktop-sidebar" transition:persist="sidebar-desktop">
      <Sidebar />
    </aside>

    <dialog id="mobile-sidebar-drawer" class="mobile-sidebar-drawer" aria-labelledby="mobile-nav-title">
      <div class="mobile-sidebar-header">
        <h2 id="mobile-nav-title">分类导航</h2>
        <button id="close-mobile-sidebar" class="icon-button" aria-label="关闭侧边栏">
          <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-width="1.7" d="m6 6 12 12M6 18 18 6" /></svg>
        </button>
      </div>
      <Sidebar />
    </dialog>

    <div class="site-content">
      <main id="main-content" class="page-content" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>

    <script>
      function initAppInteractions() {
        const toggle = document.getElementById('mobile-sidebar-toggle');
        const drawer = document.getElementById('mobile-sidebar-drawer') as HTMLDialogElement;
        const close = document.getElementById('close-mobile-sidebar');
        if (toggle) toggle.onclick = () => {
          drawer.showModal();
          toggle.setAttribute('aria-expanded', 'true');
        };
        if (close) close.onclick = () => drawer.close();
        drawer.onclose = () => toggle?.setAttribute('aria-expanded', 'false');
        drawer.onclick = (event) => {
          if (event.target === drawer || (event.target as Element).closest('a')) drawer.close();
        };

        document.querySelectorAll<HTMLAnchorElement>('.header-nav-link').forEach((link) => {
          const path = location.pathname.replace(/\/$/, '') || '/';
          if ((new URL(link.href).pathname.replace(/\/$/, '') || '/') === path) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
        });

        const video = document.getElementById('bg-video') as HTMLVideoElement;
        const button = document.getElementById('background-toggle');
        const updateVideoUI = () => {
          const label = video.paused ? '播放背景视频' : '暂停背景视频';
          button?.setAttribute('aria-label', label);
          button?.setAttribute('title', label);
          button?.setAttribute('aria-pressed', String(video.paused));
          document.getElementById('background-pause-icon')?.classList.toggle('hidden', video.paused);
          document.getElementById('background-play-icon')?.classList.toggle('hidden', !video.paused);
        };
        let preference;
        try { preference = localStorage.getItem('background-paused'); } catch {}
        const pause = preference === 'true' || (!preference && matchMedia('(prefers-reduced-motion: reduce)').matches);
        if (pause) video.pause();
        else video.play().catch(updateVideoUI);
        video.onplay = updateVideoUI;
        video.onpause = updateVideoUI;
        updateVideoUI();
        if (button) button.onclick = () => {
          const pause = !video.paused;
          try { localStorage.setItem('background-paused', String(pause)); } catch {}
          if (pause) video.pause();
          else video.play().catch(updateVideoUI);
          updateVideoUI();
        };
      }
      document.addEventListener('astro:page-load', initAppInteractions);
      matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
        if (event.matches) (document.getElementById('mobile-sidebar-drawer') as HTMLDialogElement)?.close();
      });
    </script>
  </body>
</html>
